// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "mouse_wheel_zoom": true,
  "title_bar": {
    "show_branch_status_icon": true,
    "show_branch_name": true,
    "show_project_items": false,
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_menu": true,
    "show_menus": false
  },
  "window_decorations": "server",
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "terminal": {
    "font_family": "LythMono Nerd Font",
    "scroll_multiplier": 2.0,
    "font_size": 13.5
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "cursor_shape": "bar",
  "instrumentation": {
    "performance_profiler": {
      
    }
  },
  "base_keymap": "Emacs",
  "git": {
    "inline_blame": {
      "show_commit_summary": false
    }
  },
  "zoomed_padding": true,
  "diagnostics": {
    "inline": {
      
    }
  },
  "gutter": {
    "folds": false,
    "bookmarks": false,
    "runnables": false,
    "breakpoints": false,
    "line_numbers": false
  },
  "vim": {
    "toggle_relative_line_numbers": false
  },
  "ui_font_family": "SF Pro Text",
  "buffer_font_family": "LythMono Nerd Font",
  "helix_mode": false,
  "proxy": "",
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 16.0,
  "theme": "Naysayer",
}
