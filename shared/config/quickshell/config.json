{
  "version": 1,
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "tsp.clock",
    "layout": {
      "left": [
        { "id": "tsp.workspaces" },
        { "id": "tsp.active-window", "maxWidth": 360 }
      ],
      "center": [
        { "id": "tsp.clock", "format": "dddd HH:mm", "formatAlt": "d MMMM yyyy" },
        { "id": "tsp.media" }
      ],
      "right": [
        { "id": "tsp.tray" },
        { "id": "tsp.bluetooth" },
        { "id": "tsp.network" },
        { "id": "tsp.audio" },
        { "id": "tsp.power" }
      ]
    }
  },
  "plugins": []
}
