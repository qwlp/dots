{
  "version": 1,
  "bar": {
    "position": "right",
    "transparent": false,
    "centerAnchor": "tsp.clock",
    "layout": {
      "left": [
        {
          "id": "tsp.active-window",
          "maxWidth": 360
        },
        {
          "id": "tsp.workspaces"
        }
      ],
      "center": [
        {
          "id": "tsp.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM yyyy",
          "verticalFormat": "HH\nmm"
        },
        {
          "id": "tsp.media"
        }
      ],
      "right": [
        {
          "id": "tsp.tray"
        },
        {
          "id": "tsp.bluetooth"
        },
        {
          "id": "tsp.network"
        },
        {
          "id": "tsp.audio"
        },
        {
          "id": "tsp.power"
        }
      ]
    }
  },
  "plugins": []
}
