#!/bin/sh

windows=$(niri msg --json windows 2>/dev/null) || exit 1

# Prefer AyuGram's main window over media viewers or other auxiliary windows.
window_id=$(printf '%s\n' "$windows" | jq -r '
  (map(select(.app_id == "com.ayugram.desktop" and .title == "AyuGram"))
   + map(select(.app_id == "com.ayugram.desktop")))
  | first | .id // empty
')

if [ -z "$window_id" ]; then
  exec AyuGram
fi

is_focused=$(printf '%s\n' "$windows" | jq -r --argjson id "$window_id" '
  first(.[] | select(.id == $id)) | .is_focused
')

if [ "$is_focused" = "true" ]; then
  exec niri msg action close-window
fi

exec niri msg action focus-window --id "$window_id"
