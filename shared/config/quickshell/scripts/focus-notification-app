#!/bin/sh

app_name=${1:-}
app_icon=${2:-}

window_id=$(niri msg --json windows 2>/dev/null | jq -r \
  --arg app "$app_name" \
  --arg icon "$app_icon" '
    def norm: ascii_downcase | gsub("[^a-z0-9]"; "");
    ($app | norm) as $app_key |
    ($icon | sub("^file://"; "") | split("/") | last | sub("\\.[^.]+$"; "") | norm) as $icon_key |
    map(. + {
      app_key: (.app_id | norm),
      title_key: (.title | norm),
      focused_at: ((.focus_timestamp.secs // 0) * 1000000000 + (.focus_timestamp.nanos // 0))
    }) |
    map(select(
      ($icon_key != "" and .app_key == $icon_key) or
      ($app_key != "" and .app_key == $app_key) or
      ($icon_key != "" and (.app_key | contains($icon_key))) or
      ($app_key != "" and ((.app_key | contains($app_key)) or (.title_key | contains($app_key))))
    )) |
    sort_by(.focused_at) | last | .id // empty
  ')

[ -n "$window_id" ] || exit 0
exec niri msg action focus-window --id "$window_id"
