#!/bin/sh

app_id="chrome-www.perplexity.ai__-Default"

find_window() {
  niri msg --json windows 2>/dev/null | jq -r --arg app_id "$app_id" '
    map(select(.app_id == $app_id)) | first | .id // empty
  '
}

windows=$(niri msg --json windows 2>/dev/null) || exit 1
window_id=$(printf '%s\n' "$windows" | jq -r --arg app_id "$app_id" '
  map(select(.app_id == $app_id)) | first | .id // empty
')
if [ -n "$window_id" ]; then
  is_focused=$(printf '%s\n' "$windows" | jq -r --argjson id "$window_id" '
    first(.[] | select(.id == $id)) | .is_focused
  ')
  if [ "$is_focused" = "true" ]; then
    exec niri msg action close-window --id "$window_id"
  fi
  exec niri msg action focus-window --id "$window_id"
fi

helium-browser --ozone-platform=wayland \
  --app=https://www.perplexity.ai/ >/dev/null 2>&1

attempt=0
while [ "$attempt" -lt 30 ]; do
  window_id=$(find_window)
  if [ -n "$window_id" ]; then
    exec niri msg action focus-window --id "$window_id"
  fi
  attempt=$((attempt + 1))
  sleep 0.1
done

exit 1
